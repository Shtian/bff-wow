    "GetChannelList",
    "GetChannelName",
    "GetCursorPosition",
    "GetCursorInfo",
    "GetInstanceInfo",
    "GetGameTime",
    "GetItemIcon",
    "GetItemInfo",
    "GetLocale",
    "GetLootSlotInfo",
    "GetLootSlotLink",
    "GetLootSourceInfo",
    "GetMaxLevelForPlayerExpansion",
    "GetMoney",
    "GetNumLootItems",
    "GetNumGroupMembers",
    "GetProfessionInfo",
    "GetProfessions",
    "GetRealZoneText",
    "GetServerTime",
    "GetShapeshiftFormID",
    "GetSubZoneText",
    "GetTime",
    "HBD_PINS_WORLDMAP_SHOW_WORLD",
    "HideUIPanel",
    "hooksecurefunc",
    "InCombatLockdown",
    "IsFlying",
    "IsModifiedClick",
    "IsResting",
    "OpenWorldMap",
    "ShowUIPanel",
    "UnitIsAFK",
    "IsShiftKeyDown",
    "IsMouseButtonDown",
    "IsInInstance",
    "IsInRaid",
    "IsFishingLoot",
    "ItemLocation",
    "JoinTemporaryChannel",
    "LeaveChannelByName",
    "ListChannelByName",
    "LOCALIZED_CLASS_NAMES_MALE",
    "MenuResponse",
    "MenuUtil",
    "NO",
    "NUM_BAG_SLOTS",
    "NUM_CHAT_WINDOWS",
    "NUM_TOTAL_EQUIPPED_BAG_SLOTS",
    "PixelUtil",
    "PlaySound",
    "RAID_CLASS_COLORS",
    "RemoveChatWindowChannel",
    "StaticPopup_Show",
    "SOUNDKIT",
    "time",
    "UIParent",
    "UISpecialFrames",
    "UnitClass",
    "UnitClassification",
    "UnitExists",
    "UnitFactionGroup",
    "UnitGUID",
    "UnitIsDead",
    "UnitIsDeadOrGhost",
    "UnitIsTapDenied",
    "UnitLevel",
    "UnitOnTaxi",
